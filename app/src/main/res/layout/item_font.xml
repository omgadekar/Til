<?xml version="1.0" encoding="utf-8"?>
<!--
  One typeface, shown as the live day count in the colours the wallpaper will use.

  Every part of the row is silent to a screen reader; FontAdapter describes the row as a
  whole instead, because a sample reading out as a bare number tells a listener nothing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/font_sample"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/font_sample_bg"
        android:fontFeatureSettings="tnum, lnum"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:textSize="27sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/font_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/font_note"
            style="@style/RowNote"
            android:importantForAccessibility="no"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/font_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:importantForAccessibility="no"
        android:text="@string/check_mark"
        android:textColor="@color/accent"
        android:textSize="17sp" />

</LinearLayout>
