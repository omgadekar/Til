<?xml version="1.0" encoding="utf-8"?>
<!--
  A thin case around the preview, so a dark wallpaper still reads as a screen.

  The fill is a shallow top-to-bottom gradient rather than one flat tone: every shadow and
  highlight on this page is lit from above, and a flat bezel is the one surface that would
  not agree with that.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#121110"
        android:startColor="#201D19"
        android:type="linear" />
    <corners android:radius="28dp" />
    <stroke android:width="1dp" android:color="#2E2A25" />
</shape>
