<?xml version="1.0" encoding="utf-8"?>
<!--
  A dialog floats above the rows, so it is a step lighter than them (#171613) rather than
  the same tone, and warm like everything else above the page. It was left on the old
  neutral grey when the palette was warmed, which is why it used to read as a different
  material from the screen behind it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1C1A17" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="#302C26" />
</shape>
