<?xml version="1.0" encoding="utf-8"?>
<!--
  A countdown dial: a ring most of the way round, open at the top, with the marker sitting
  in the gap. Reads as time running out rather than as a clock, and it stays legible at
  launcher size because it is two shapes and no detail.

  Geometry is kept inside the 66dp safe circle of the 108dp adaptive canvas: the ring is
  r=26 with a 7 stroke, so its outer edge lands at 29.5 from centre.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:pathData="M64.99,30.44 A26,26 0 1 1 43.01,30.44"
        android:strokeColor="#C8A961"
        android:strokeLineCap="round"
        android:strokeWidth="7" />
    <path
        android:fillColor="#F2EDE4"
        android:pathData="M54,23.5 a4.5,4.5 0 1 0 0.01,0 z" />
</vector>
