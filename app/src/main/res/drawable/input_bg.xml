<?xml version="1.0" encoding="utf-8"?>
<!--
  The text field wears the same surface as a settings row rather than a bare underline, so
  the dialog is built from the same parts as the screen behind it. The focused state is the
  gold hairline the rows already use; a field that is focused the moment the dialog opens
  then says where to type without needing a caret to be noticed.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/hairline" />
        </shape>
    </item>
</selector>
