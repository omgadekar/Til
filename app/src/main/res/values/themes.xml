<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Always dark, never DayNight: the window is a frame around a preview of the wallpaper,
      so the page matching the wallpaper's own palette is the point. This also drags the
      dialogs dark with it instead of flashing a white sheet over a black app.
    -->
    <style name="Theme.Til" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="alertDialogTheme">@style/Theme.Til.Dialog</item>
    </style>

    <!--
      The container was themed here from the start, but the title and the buttons inside it
      were left stock: Roboto Medium caps, and three identical gold text buttons with no
      hierarchy on a screen whose primary action is a filled gold bar. Styling them at the
      theme level fixes every dialog at once rather than one of the three.
    -->
    <style name="Theme.Til.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowTitleStyle">@style/DialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButton</item>
    </style>

    <style name="DialogTitle">
        <item name="android:textAppearance">@style/DialogTitle.Text</item>
    </style>

    <style name="DialogTitle.Text" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Sentence case, because the tracked caps elsewhere are a label system, not a button one. -->
    <style name="DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- The one action that commits gets the fill, so the three stop looking interchangeable. -->
    <style name="DialogButton.Positive">
        <item name="android:background">@drawable/button_accent_compact</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <!-- DatePickerDialog is a framework dialog, so it needs a framework theme of its own. -->
    <style name="Theme.Til.DatePicker" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:datePickerStyle">@style/Widget.Til.DatePicker</item>
    </style>

    <!--
      The header ships with its own opaque band, which squares off the corners the rounded
      dialog background just rounded. Letting it through to the sheet keeps the shape.
    -->
    <style name="Widget.Til.DatePicker" parent="android:Widget.Material.DatePicker">
        <item name="android:headerBackground">@android:color/transparent</item>
    </style>

    <!--
      Type scale.

      The wallpaper is a large light serif numeral over a small tracked sans caption. The page
      is that same pairing one size down: a light display line for the name, tracked caps for
      the section labels, plain sans for the values. The four bundled serifs are subset to
      digits, so none of this chrome can be set in them - the register of the wallpaper has to
      be carried by weight and tracking instead.
    -->
    <!--
      The name is a three-letter all-caps wordmark, so this tracks OUT, not in. Negative
      tracking is right for long mixed-case display text, where letters drift apart as the
      type grows; caps are uniform in width and jam together instead, and three of them with
      nothing around them need the air to read as a mark rather than an abbreviation.
    -->
    <style name="Display">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">40sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- The live count under the name. Tabular, so the line holds still as digits change. -->
    <style name="Subtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFeatureSettings">tnum, lnum</item>
    </style>

    <!-- Small tracked-out caps above each control group. -->
    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">30dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <!-- Medium, not regular: 11sp caps go spindly at 400 once tracked this far. -->
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.16</item>
    </style>

    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/row_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="RowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- The second line in a row: what the setting does, under what it is set to. -->
    <style name="RowNote">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!--
      Secondary action beside the quick-pick swatches. 48dp minimums rather than padding
      alone, so the target clears the floor whatever the label says.
    -->
    <style name="GhostButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/button_ghost</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@animator/press</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/button_accent</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:stateListAnimator">@animator/press</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Til.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>

</resources>
